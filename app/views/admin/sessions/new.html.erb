<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin sign in</title>
    <style>
      :root { color-scheme: light; font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
      * { box-sizing: border-box; }
      body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 24px; color: #172033; background: radial-gradient(circle at top left, #e8f0ff, transparent 45%), #f5f7fb; }
      .card { width: min(100%, 420px); padding: 40px; border: 1px solid #e4e8f0; border-radius: 18px; background: #fff; box-shadow: 0 24px 70px rgba(27, 39, 65, .12); }
      .eyebrow { margin: 0 0 10px; color: #5368d8; font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
      h1 { margin: 0; font-size: 28px; letter-spacing: -.03em; }
      .intro { margin: 10px 0 28px; color: #647084; line-height: 1.5; }
      label { display: block; margin: 18px 0 8px; font-size: 14px; font-weight: 650; }
      input { width: 100%; height: 48px; padding: 0 14px; border: 1px solid #d7dce6; border-radius: 9px; outline: none; background: #fff; color: #172033; font: inherit; }
      input:focus { border-color: #5368d8; box-shadow: 0 0 0 3px rgba(83, 104, 216, .15); }
      .remember { display: flex; align-items: center; gap: 9px; margin: 17px 0 22px; color: #596579; font-size: 14px; }
      .remember input { width: 16px; height: 16px; margin: 0; }
      button { width: 100%; min-height: 48px; border: 0; border-radius: 9px; background: #4056c6; color: #fff; cursor: pointer; font: inherit; font-weight: 700; }
      button:hover { background: #3449b2; }
      .message { margin: 16px 0 0; padding: 12px 14px; border-radius: 8px; background: #fff1f0; color: #9f3028; font-size: 14px; }
      .footer { margin: 22px 0 0; color: #8a93a3; font-size: 12px; text-align: center; }
      @media (max-width: 480px) { .card { padding: 30px 24px; } }
    </style>
  </head>
  <body>
    <main class="card">
      <h1>Admin sign in</h1>
      <p class="intro">Enter your administrator credentials to open the dashboard.</p>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |form| %>
        <%= form.label :email %>
        <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true %>

        <%= form.label :password %>
        <%= form.password_field :password, autocomplete: "current-password", required: true %>

        <% if devise_mapping.rememberable? %>
          <label class="remember">
            <%= form.check_box :remember_me %>
            Remember me
          </label>
        <% end %>

        <%= form.submit "Sign in", class: "submit", data: { turbo: false } %>
      <% end %>

      <% if flash[:alert].present? %>
        <p class="message" role="alert"><%= flash[:alert] %></p>
      <% end %>
      <% if resource.errors.any? %>
        <p class="message" role="alert"><%= resource.errors.full_messages.to_sentence %></p>
      <% end %>

      <p class="footer">Administrator access only</p>
    </main>
  </body>
</html>
